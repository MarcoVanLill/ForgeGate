FORGEGATE_ENV=development
FORGEGATE_LOG_LEVEL=info
FORGEGATE_HTTP_ADDR=:8080
FORGEGATE_DATABASE_URL=postgres://forgegate:forgegate@postgres:5432/forgegate?sslmode=disable
FORGEGATE_REDIS_ADDR=redis:6379
FORGEGATE_NATS_URL=nats://nats:4222
FORGEGATE_OTEL_ENDPOINT=otel-collector:4317
FORGEGATE_MIGRATE_ON_START=true
FORGEGATE_SHUTDOWN_TIMEOUT=20s
FORGEGATE_REQUEST_TIMEOUT=30s
FORGEGATE_OUTBOX_POLL_INTERVAL=500ms
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com
OPENAI_COMPATIBLE_API_KEY=
GEMINI_API_KEY=
